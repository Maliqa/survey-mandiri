# Copy to .env on the VPS (chmod 600). Never commit the real .env.

# --- Domain / TLS ---------------------------------------------------------------
# No domain yet? Use <your-vps-ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=api.surveymandiri.example.com

# --- Image (set by GitHub Actions; lowercase owner) -----------------------------
BACKEND_IMAGE=ghcr.io/your-github-user/survey-mandiri-backend
IMAGE_TAG=latest

# --- Django ---------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-run-python-c-secrets-token_urlsafe-64
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.surveymandiri.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.surveymandiri.example.com
DJANGO_ADMIN_URL=kelola-7f3a/
LOG_LEVEL=INFO

# --- Database / Redis -----------------------------------------------------------
POSTGRES_DB=survey_mandiri
POSTGRES_USER=survey_mandiri
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://survey_mandiri:change-me-long-random@db:5432/survey_mandiri
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# --- JWT ------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# --- Business rules -------------------------------------------------------------
COMMISSION_PERCENT=20
MAX_UNITS_PER_SURVEYOR=50
REPORT_MAX_AGE_HOURS=72
REPORT_MAX_DISTANCE_KM=2
REVIEW_WINDOW_DAYS=3
DEMO_PAYMENTS=1
MAX_UPLOAD_MB=8
