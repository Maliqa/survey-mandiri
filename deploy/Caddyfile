{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# no-referrer makes browsers send "Origin: null" on POST, which breaks Django CSRF (admin login).
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Media is never served directly: Django checks permissions for every file.
	reverse_proxy web:8000
}
