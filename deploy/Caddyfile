{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# no-referrer makes browsers send "Origin: null" on POST, which breaks Django CSRF (admin login).
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Customer download page + APK (uploaded by the Android workflow).
	redir /download /download/
	handle_path /download/* {
		root * /srv/public
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Cache-Control no-cache
		file_server
	}

	# Everything else is the Django API/admin. Media is never served directly:
	# Django checks permissions for every file.
	handle {
		reverse_proxy web:8000
	}
}
